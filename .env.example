# Required PostgreSQL connection string. Create a PostgreSQL database in Replit and copy its URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Required for local-only guest identities to be created. Use a long random value in production.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Required only if you want real YouTube channel lookup and channel synchronization.
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=10000
CHANNEL_SYNC_CRON=0 */3 * * *

# Required only if you want Gemini chat/summaries. Keep this on the server only.
GEMINI_API_KEY=
GEMINI_MODEL_OVERRIDE=
GEMINI_FALLBACK_MODEL=

# Required to access the protected owner dashboard. Never use the guest name as admin security.
ADMIN_PASSWORD=change-this-to-a-long-unique-password

# Optional
PORT=3001
NODE_ENV=development
