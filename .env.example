# انسخ هذا الملف إلى .env وضع القيم الحقيقية محليًا. لا ترفع .env إلى GitHub.
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# قاعدة البيانات SQLite محلية داخل data/؛ لا تحتاج خدمة خارجية.
DATABASE_FILE=./data/kholasat.sqlite

# مطلوب لحماية لوحة المالك. اختر كلمة مرور طويلة وفريدة.
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ADMIN_SESSION_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET

# اختياري: وظائف YouTube لا تعمل دون مفتاح من Google Cloud.
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_BUDGET=10000

# اختياري: وظائف جيمناوي لا تعمل دون مفتاح Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# مجلد بيانات SQLite عند النشر يجب أن يكون على تخزين دائم.
